# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel (content management)
ADMIN_PASSWORD=omathome
ADMIN_SESSION_TOKEN=change-this-session-token

# Stripe (test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Public contact email (Distance Reiki / Ask the Rods requests)
NEXT_PUBLIC_CONTACT_EMAIL=your-email@gmail.com

# NodeMailer (signup OTP emails) — add the same keys in Vercel → Settings → Environment Variables
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Om At Home <your-email@gmail.com>"

# After deploying: run supabase/signup-otps.sql in Supabase SQL Editor (stores OTP codes for Vercel)
