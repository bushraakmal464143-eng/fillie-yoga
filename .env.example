SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin desk — log in on the main site (Log in) with this email + password
ADMIN_EMAIL=gillania349@gmail.com
ADMIN_PASSWORD=Filliefaragie@admin$
ADMIN_SESSION_TOKEN=change-this-session-token

# Stripe (test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Optional: Stripe CLI / Dashboard webhook signing secret for checkout.session.completed
